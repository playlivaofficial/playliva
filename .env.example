# Optional public settings. No custom environment variables are needed locally.
# Uncomment only when supplying a real value in an ignored .env.local file.
# Keep SITE_URL unset to use the application's existing canonical origin;
# an empty active assignment would override that default.
# NEXT_PUBLIC_SITE_URL=

# Optional GA4 public measurement ID; leave unset to keep GA4 disabled.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional public Google Search Console verification token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
