{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx scripts/avia-build-preflight.mjs && node --import tsx scripts/validate-catalog.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 3",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:routes": "node --import tsx tests/routes.mjs",
    "social:review": "node --import tsx scripts/social/review.mjs",
    "social:capture": "node --import tsx scripts/social/capture-shorts.mjs",
    "social:voice:setup": "node scripts/social/setup-voice-runtime.mjs",
    "social:voice": "node scripts/social/run-voice.mjs",
    "social:inspect": "node --import tsx scripts/social/inspect-shorts.mjs",
    "social:youtube:auth": "node --import tsx scripts/social/youtube-auth.mjs",
    "social:youtube:upload": "node --import tsx scripts/social/youtube-upload.mjs",
    "social:youtube:verify": "node --import tsx scripts/social/youtube-verify.mjs",
    "social:secrets": "node scripts/social/secret-scan.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "three": "0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "ffmpeg-static": "5.3.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.5",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "msw",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
